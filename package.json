{
  "name": "@xiaoke8698/dsh-memory-forget",
  "version": "0.2.0",
  "description": "Forgetting engine for AI agents — memory TTL, decay, eviction, audit. The opposite of memory programming.",
  "type": "module",
  "license": "MIT",
  "author": "XIAOke8698",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XIAOke8698/dsh-memory-forget.git"
  },
  "homepage": "https://github.com/XIAOke8698/dsh-memory-forget",
  "bugs": {
    "url": "https://github.com/XIAOke8698/dsh-memory-forget/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "memory",
    "forgetting",
    "agent-memory",
    "llm-agents",
    "ai-agents",
    "memory-management",
    "memory-eviction",
    "amnesia",
    "deepseek",
    "context-management",
    "privacy"
  ],
  "files": [
    "dist",
    "plugin",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "import": "./plugin/index.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
